# 生产环境密钥模板
# 复制到 /etc/ka.env 并 chmod 600，部署脚本与 systemd 服务会自动加载

# MySQL（与 docker-compose 中 MYSQL_USER/MYSQL_PASSWORD 保持一致）
DB_USER=ka_user
DB_PASS=请改成强密码

# Redis 口令
REDIS_PASS=请改成强密码

# JWT 签名密钥（至少 32 字节随机串，例：openssl rand -base64 48）
JWT_SECRET=请改成随机密钥

# Agent 内部鉴权密钥（backend AGENT_API_KEY 与 agent KA_INTERNAL_API_KEY 共用）
KA_INTERNAL_API_KEY=请改成随机密钥

# DeepSeek API Key
KA_DEEPSEEK_API_KEY=sk-请填入
