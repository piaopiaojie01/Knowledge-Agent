# 生产环境密钥模板
# 复制到 /etc/ka.env 并 chmod 600，部署脚本与 systemd 服务会自动加载

# MySQL（与 docker-compose 中 MYSQL_USER/MYSQL_PASSWORD 保持一致）
MYSQL_ROOT_PASSWORD=请改成强密码
DB_USER=ka_user
DB_PASS=请改成强密码

# Redis 口令
REDIS_PASS=请改成强密码

# MinIO（Milvus 底层对象存储，AccessKey/SecretKey 需一致）
MINIO_ACCESS_KEY=请改成随机串
MINIO_SECRET_KEY=请改成随机串

# JWT 签名密钥（至少 32 字节随机串，例：openssl rand -base64 48）
JWT_SECRET=请改成随机密钥

# Agent 内部鉴权密钥（backend AGENT_API_KEY 与 agent KA_INTERNAL_API_KEY 共用）
KA_INTERNAL_API_KEY=请改成随机密钥

# DeepSeek API Key
KA_DEEPSEEK_API_KEY=sk-请填入

# 系统管理员账号（首次启动自动创建/升级默认密码）
KA_ADMIN_USERNAME=admin
KA_ADMIN_PASSWORD=请改成强密码

# 宿主机映射端口（可选，默认 8080/80/443）
BACKEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
