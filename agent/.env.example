# Knowledge Agent 环境变量配置
# 复制此文件为 .env 并修改配置

# DeepSeek API Key (必填，用于 LLM 生成)
KA_DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek 配置
KA_DEEPSEEK_BASE_URL=https://api.deepseek.com
KA_DEEPSEEK_MODEL=deepseek-v4-flash

# BGE Embedding 模型
KA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KA_EMBEDDING_DIM=512
KA_EMBEDDING_DEVICE=cpu

# Milvus
KA_MILVUS_HOST=localhost
KA_MILVUS_PORT=19530

# Redis
KA_REDIS_HOST=localhost
KA_REDIS_PORT=6379
KA_REDIS_PASSWORD=ka_redis_dev_2026

# ── 安全配置（P0）──
# 内部 API Key：Spring Boot 调用 Agent 时携带 X-KA-API-Key，必须与后端 AGENT_API_KEY 一致
KA_INTERNAL_API_KEY=ka-internal-dev-key

# CORS 白名单（默认空 = 不开放跨域，Agent 仅服务后端调用）
KA_CORS_ORIGINS=[]

# url_fetch 工具域名白名单（空 = 禁用该工具）
KA_URL_FETCH_ALLOWLIST=[]

# web_extract 爬虫域名白名单（空 = 回退 url_fetch 白名单；两者都空则禁用）
KA_CRAWL_ALLOWLIST=[]

# 上传体积上限（MB）
KA_MAX_UPLOAD_MB=100

# 运行时产物目录与访问地址（容器部署请挂载卷并显式配置）
KA_CHART_OUTPUT_DIR=
KA_ICON_OUTPUT_DIR=
KA_CHART_BASE_URL=http://localhost:8080

# RAG 参数
KA_RETRIEVAL_TOP_K=5
KA_RERANK_TOP_K=3

# 分块：token 估算 + 语义分块（BGE 相邻句相似度断点，低于阈值断开）
KA_CHUNK_TOKENS=450
KA_CHUNK_OVERLAP_TOKENS=60
KA_SEMANTIC_CHUNKING=true
KA_SEMANTIC_CHUNK_THRESHOLD=0.45
