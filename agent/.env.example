# Knowledge Agent 环境变量配置
# 复制此文件为 .env 并修改配置

# DeepSeek API Key (必填，用于 LLM 生成)
KA_DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek 配置
KA_DEEPSEEK_BASE_URL=https://api.deepseek.com
KA_DEEPSEEK_MODEL=deepseek-chat

# BGE Embedding 模型
KA_EMBEDDING_MODEL=BAAI/bge-m3
KA_EMBEDDING_DIM=1024
KA_EMBEDDING_DEVICE=cpu

# Milvus
KA_MILVUS_HOST=localhost
KA_MILVUS_PORT=19530

# Redis
KA_REDIS_HOST=localhost
KA_REDIS_PORT=6379

# RAG 参数
KA_RETRIEVAL_TOP_K=5
KA_RERANK_TOP_K=3
