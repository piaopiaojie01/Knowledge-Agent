# 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# 本地开发示例值见下方注释；生产环境务必使用强随机密码

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=ka_user
DB_PASS=change-me-db

# Redis
REDIS_PASS=change-me-redis

# MinIO（Milvus 底层对象存储）
MINIO_ACCESS_KEY=change-me-minio-key
MINIO_SECRET_KEY=change-me-minio-secret

# JWT 签名密钥（至少 32 字节随机串，生成：openssl rand -base64 48）
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes

# Agent 内部鉴权密钥（backend AGENT_API_KEY 与 agent KA_INTERNAL_API_KEY 共用）
KA_INTERNAL_API_KEY=change-me-internal-key

# DeepSeek API Key（可选，留空则模型配置页填写）
KA_DEEPSEEK_API_KEY=

# HTTPS 部署时置 true（Cookie 加 Secure 标志）
KA_COOKIE_SECURE=false
